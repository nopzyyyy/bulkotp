# Leave these unset in production until the NOWPayments account and IPN
# callback secret are ready. Crypto checkout stays visibly disabled without
# both values, and no key can be delivered through the placeholder flow.
NOWPAYMENTS_API_KEY=replace_with_live_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=replace_with_live_nowpayments_ipn_secret
PUBLIC_BASE_URL=https://your-store-domain.example

# Optional
PORT=5500
